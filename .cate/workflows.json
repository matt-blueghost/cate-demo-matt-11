{
  "version": "2",
  "project": {
    "name": "cate-demo-matt-11",
    "description": "Demo shopping cart project — powered by Cate"
  },
  "tracker": {
    "provider": "github",
    "owner": {
      "name": "matt-blueghost",
      "type": "OWNER_TYPE_USER"
    },
    "repo": "cate-demo-matt-11",
    "projectName": "cate-demo-matt-11",
    "projectNumber": 12,
    "statusFieldId": "PVTSSF_lAHOD8maUs4BSqJ1zhAIMEY",
    "statusOptions": {
      "ready": {
        "optionId": "fe3aa7e9"
      },
      "in_progress": {
        "optionId": "a88ba220"
      },
      "in_review": {
        "optionId": "c76db955"
      },
      "human_review": {
        "optionId": "8bd66351"
      },
      "done": {
        "optionId": "a8a101c1"
      }
    }
  },
  "git": {
    "defaultBranch": "main",
    "branchPattern": "task/ISSUE-{number}-{description}",
    "commitFormat": "conventional"
  },
  "autonomy": {
    "default": "full"
  },
  "statuses": [
    {
      "id": "ready",
      "name": "To Do",
      "color": "#3b82f6"
    },
    {
      "id": "in_progress",
      "name": "In Progress",
      "color": "#f59e0b"
    },
    {
      "id": "in_review",
      "name": "AI Review",
      "color": "#8b5cf6"
    },
    {
      "id": "human_review",
      "name": "In Review",
      "color": "#ec4899"
    },
    {
      "id": "done",
      "name": "Done",
      "color": "#22c55e"
    }
  ],
  "commands": {
    "work": {
      "name": "Work",
      "description": "Find and execute the highest-priority task",
      "prompt": "commands/work.md",
      "tab": {
        "persistent": {
          "minAllocation": 3
        }
      },
      "parameters": {
        "issue_id": {
          "type": "string",
          "required": true,
          "description": "The issue number to work on"
        }
      },
      "transitions": [
        {
          "from": "ready",
          "to": "in_progress",
          "on": "claim_new"
        },
        {
          "from": "in_progress",
          "to": "in_review",
          "on": "submit"
        },
        {
          "from": "ready",
          "to": "in_progress",
          "on": "promote_parent"
        },
        {
          "from": "in_progress",
          "to": "ready",
          "on": "stuck"
        }
      ]
    },
    "review": {
      "name": "Review",
      "description": "Review a pull request for correctness and quality",
      "prompt": "commands/review.md",
      "tab": {
        "persistent": {
          "minAllocation": 1
        }
      },
      "parameters": {
        "issue_id": {
          "type": "string",
          "required": true,
          "description": "The issue to review"
        }
      },
      "transitions": [
        {
          "from": "in_review",
          "to": "human_review",
          "on": "approve"
        },
        {
          "from": "in_review",
          "to": "done",
          "on": "approve_subtask"
        },
        {
          "from": "in_review",
          "to": "human_review",
          "on": "approve_supervised"
        },
        {
          "from": "in_review",
          "to": "ready",
          "on": "request_changes"
        },
        {
          "from": "in_progress",
          "to": "human_review",
          "on": "complete_epic"
        }
      ]
    },
    "run_config": {
      "name": "Run Config",
      "description": "Generate or update run configurations interactively",
      "prompt": "commands/run-config.md",
      "tab": {
        "ephemeral": {}
      }
    },
    "custom_workflow": {
      "name": "Custom Workflow",
      "description": "Create a new custom workflow interactively",
      "prompt": "commands/custom-workflow.md",
      "tab": {
        "ephemeral": {}
      }
    }
  },
  "queue": {
    "worker": {
      "entries": [
        {
          "status": "ready"
        }
      ]
    },
    "reviewer": {
      "entries": [
        {
          "status": "in_review"
        }
      ]
    },
    "human-review": {
      "entries": [
        {
          "status": "human_review"
        }
      ]
    },
    "in_progress": {
      "entries": [
        {
          "status": "in_progress"
        }
      ]
    }
  },
  "demo": true
}