{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(git:*)",
      "Bash(npm *)",
      "Bash(npm:*)",
      "Bash(npx nuxt *)",
      "Bash(npx vitest *)",
      "Bash(echo *)",
      "Bash(git diff main...HEAD --stat && echo \"---\" && git log main..HEAD --oneline)",
      "Bash(.cate/scripts/*)",
      "Bash(.cate/scripts/* *)",
      "Glob",
      "Grep",
      "Read",
      "mcp__leftenant__*"
    ],
    "defaultMode": "acceptEdits"
  },
  "enabledMcpjsonServers": [
    "leftenant"
  ],
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|structured_choice|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/cate/needs-attention.mjs\"",
            "async": true
          }
        ]
      }
    ]
  }
}
